VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Local Ollama. The web app checks whether Ollama is already running; it does not start Ollama.
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gemma3

# Optional remote Ollama fallback. Keep disabled until a protected reverse-proxied Ollama endpoint is ready.
VITE_REMOTE_OLLAMA_ENABLED=false
VITE_REMOTE_OLLAMA_URL=
VITE_REMOTE_OLLAMA_MODEL=

# Optional paid/server AI endpoint for a later backend gateway. Not used in the default provider order.
# Do not put paid provider secrets in VITE_* env vars.
VITE_AI_SERVER_URL=
