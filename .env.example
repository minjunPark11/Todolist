VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# 서버(MCP)용. Vercel 함수는 import.meta.env를 읽지 못한다.
# VITE_ 접두사가 붙은 위 두 값으로 대체할 수 있지만, 배포에서는 아래를 쓴다.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# 이 앱의 공개 주소. /.well-known/oauth-protected-resource가 이 값으로
# resource를 만든다. Vercel에서는 VERCEL_URL이 자동으로 대신한다.
# 없으면 메타데이터는 404를 준다 — 틀린 호스트를 광고하는 것보다 낫다.
APP_URL=
