{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capabilities",
  "windows": ["main", "focus-mini-timer"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    },
    "notification:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "updater:default",
    "process:default",
    "dialog:allow-open",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:create-app-specific-dirs",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "sql:default",
    "sql:allow-execute"
  ]
}
