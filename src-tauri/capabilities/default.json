{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capabilities",
  "windows": ["main", "focus-mini-timer"],
  "permissions": [
    "core:default",
    "http:default",
    "notification:default",
    "opener:default",
    "updater:default",
    "process:default",
    "dialog:allow-open",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat"
  ]
}
