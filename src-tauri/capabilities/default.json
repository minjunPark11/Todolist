{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capabilities",
  "windows": ["main", "focus-mini-timer"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    },
    "notification:default",
    "opener:default",
    "updater:default",
    "process:default"
  ]
}
